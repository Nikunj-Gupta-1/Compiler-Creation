Rule 16    expr -> expr PLUS term
Rule 17    expr -> expr MINUS term
Rule 18    expr -> term
Rule 19    term -> term MUL factor
Rule 20    term -> term DIV factor
Rule 21    term -> term MOD factor
Rule 22    term -> factor
Rule 23    factor -> LPAREN expr RPAREN
Rule 24    factor -> ID
Rule 25    factor -> INT
Rule 26    factor -> FLOAT
Rule 27    bool_expr -> bool_expr OR bool_term
Rule 28    bool_expr -> bool_term
Rule 29    bool_term -> bool_term AND bool_factor
Rule 30    bool_term -> bool_factor
Rule 31    bool_factor -> NOT bool_factor
Rule 32    bool_factor -> LPAREN bool_expr RPAREN
Rule 33    bool_factor -> rel_expr
Rule 34    rel_expr -> expr LT expr
Rule 35    rel_expr -> expr GT expr
Rule 36    rel_expr -> expr LE expr
Rule 37    rel_expr -> expr GE expr
Rule 38    rel_expr -> expr EQ expr
Rule 39    rel_expr -> expr NEQ expr
Rule 40    while_stmt -> WHILE LPAREN bool_expr RPAREN stmt
Rule 41    if_stmt -> IF LPAREN bool_expr RPAREN stmt ELSE stmt
Rule 42    block -> LCURLY stmt_list RCURLY
Rule 43    print_stmt -> PRINT LPAREN expr RPAREN SEMI
Rule 44    empty -> <empty>

